# E-go-web Next.js App — Project-specific .gitignore

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build

# Environment files — NEVER commit real credentials
.env
.env.*
!.env.example
!.env.template

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Coverage
/coverage

# DO NOT ignore /tests or /test — test source files are valuable
# DO NOT ignore *.test.* or *.spec.* — test source files are valuable
