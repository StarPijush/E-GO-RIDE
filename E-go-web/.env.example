# E-GO Web environment configuration.
# Copy to .env.local for development.

# Enables the demo account and mock OTP UI. Automatically disabled in production builds.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# OpenStreetMap-compatible tile server. Override for a production tile provider.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Set to true to render the text map fallback (useful for CI / visual tests).
NEXT_PUBLIC_DISABLE_MAP=false

# Optional deterministic simulation seed for the mock ride lifecycle.
NEXT_PUBLIC_SIM_SEED=

# Share of driver searches that fail (0 - 1). 0 keeps the demo deterministic.
NEXT_PUBLIC_SIM_FAIL_RATE=0

# Server-only demo credentials. Never prefix these with NEXT_PUBLIC_.
# They are shown by the login/OTP pages only while demo auth is enabled.
DEMO_LOGIN_PHONE=9000000001
DEMO_LOGIN_PASSWORD=EgoDemo@123
DEMO_LOGIN_OTP=123456
