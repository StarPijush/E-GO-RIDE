# E-go Flutter App — Project-specific .gitignore
# Most patterns are handled in the root .gitignore

# Flutter/Dart specific
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/test/screenshots/
test/screenshots/

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# IntelliJ/Android Studio
*.iml
*.ipr
*.iws
.idea/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
*.class
*.swp
.DS_Store

# DO NOT ignore test/ — test source files are valuable
# DO NOT ignore web/ — Flutter web source files are required
